<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool only: drives the decompiler that ships with ILSpy to print the game's
       types as C#. Not part of the plugin or the server. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ilspec</AssemblyName>
    <RootNamespace>TavernPlugin.IlSpec</RootNamespace>
    <IlspyDir Condition="'$(IlspyDir)' == ''">C:\Users\dvach\AppData\Local\Programs\ILSpy</IlspyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>$(IlspyDir)\ICSharpCode.Decompiler.dll</HintPath>
    </Reference>
    <Reference Include="ICSharpCode.ILSpyX">
      <HintPath>$(IlspyDir)\ICSharpCode.ILSpyX.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
